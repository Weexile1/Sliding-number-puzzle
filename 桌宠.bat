'@

    $parts = ($blob -replace '\s', '') -split '\|'
    $loaded = New-Object System.Collections.Generic.List[object]
    foreach ($p in $parts) {
        if ([string]::IsNullOrWhiteSpace($p)) { continue }
        $bytes = [Convert]::FromBase64String($p)
        $loaded.Add([PetFrames]::Load($bytes))
    }
    $global:frames = $loaded.ToArray()
    if ($global:frames.Count -lt 2) { throw 'Desktop pet frames did not load.' }

    $global:petName = -join @([char]0x684C, [char]0x5BA0)
    $global:exitLabel = -join @([char]0x9000, [char]0x51FA)
    $global:tipText = -join @(
        [char]0x5DE6, [char]0x952E, [char]0x62D6, [char]0x52A8,
        [char]0xFF0C, [char]0x6BCF, [char]0x0035, [char]0x79D2,
        [char]0x52A8, [char]0x4E00, [char]0x4E0B,
        [char]0xFF0C, [char]0x53F3, [char]0x952E, [char]0x9000, [char]0x51FA
    )

    [System.Windows.Forms.Application]::EnableVisualStyles()
    [System.Windows.Forms.Application]::SetCompatibleTextRenderingDefault($false)

    $global:form = New-Object System.Windows.Forms.Form
    $global:form.Text = $global:petName
    $global:form.FormBorderStyle = [System.Windows.Forms.FormBorderStyle]::None
    $global:form.StartPosition = [System.Windows.Forms.FormStartPosition]::Manual
    $global:form.ShowInTaskbar = $false
    $global:form.TopMost = $true
    $global:form.BackColor = [System.Drawing.Color]::Magenta
    $global:form.TransparencyKey = [System.Drawing.Color]::Magenta
    $global:form.AutoScaleMode = [System.Windows.Forms.AutoScaleMode]::None
    $global:form.ClientSize = New-Object System.Drawing.Size($global:frames[0].Width, $global:frames[0].Height)
    $global:form.KeyPreview = $true

    $global:pic = New-Object System.Windows.Forms.PictureBox
    $global:pic.Dock = [System.Windows.Forms.DockStyle]::Fill
    $global:pic.BackColor = [System.Drawing.Color]::Magenta
    $global:pic.SizeMode = [System.Windows.Forms.PictureBoxSizeMode]::Normal
    $global:pic.Image = $global:frames[0]
    $global:pic.Cursor = [System.Windows.Forms.Cursors]::SizeAll
    $global:form.Controls.Add($global:pic)

    $global:menu = New-Object System.Windows.Forms.ContextMenuStrip
    $exitItem = $global:menu.Items.Add($global:exitLabel)
    $exitItem.Add_Click({ $global:form.Close() })
    $global:pic.ContextMenuStrip = $global:menu

    $global:notify = New-Object System.Windows.Forms.NotifyIcon
    $global:notify.Icon = [System.Drawing.SystemIcons]::Application
    $global:notify.Visible = $true
    $global:notify.Text = $global:petName
    $global:notify.ContextMenuStrip = $global:menu

    $global:posDir = Join-Path $env:APPDATA 'TabbyDesktopPet'
    $global:posFile = Join-Path $global:posDir 'pos.txt'

    $global:SavePetPos = {
        try {
            if (-not (Test-Path -LiteralPath $global:posDir)) {
                New-Item -ItemType Directory -Path $global:posDir | Out-Null
            }
            Set-Content -LiteralPath $global:posFile -Value ("{0},{1}" -f $global:form.Left, $global:form.Top) -Encoding ASCII
        } catch {}
    }

    function Test-PetOnScreen([int]$x, [int]$y, [int]$w, [int]$h) {
        foreach ($s in [System.Windows.Forms.Screen]::AllScreens) {
            $b = $s.WorkingArea
            if (($x -lt ($b.Right - 30)) -and (($x + $w) -gt ($b.Left + 30)) -and ($y -lt ($b.Bottom - 30)) -and (($y + $h) -gt ($b.Top + 30))) {
                return $true
            }
        }
        return $false
    }

    $area = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea
    $startX = $area.Right - $global:form.Width - 48
    $startY = $area.Bottom - $global:form.Height - 24
    if (Test-Path -LiteralPath $global:posFile) {
        try {
            $bits = (Get-Content -LiteralPath $global:posFile -Raw).Trim().Split(',')
            $sx = [int]$bits[0]
            $sy = [int]$bits[1]
            if (Test-PetOnScreen $sx $sy $global:form.Width $global:form.Height) {
                $startX = $sx
                $startY = $sy
            }
        } catch {}
    }
    $global:form.Location = New-Object System.Drawing.Point($startX, $startY)

    $global:dragging = $false
    $global:offX = 0
    $global:offY = 0
    $global:playing = $false
    $global:frameIndex = 0

    $global:pic.Add_MouseDown({
        if ($_.Button -ne [System.Windows.Forms.MouseButtons]::Left) { return }
        $global:dragging = $true
        $client = $global:form.PointToClient([System.Windows.Forms.Cursor]::Position)
        $global:offX = $client.X
        $global:offY = $client.Y
        $global:pic.Capture = $true
    })
    $global:pic.Add_MouseMove({
        if (-not $global:dragging) { return }
        $cursor = [System.Windows.Forms.Cursor]::Position
        $global:form.Location = New-Object System.Drawing.Point(($cursor.X - $global:offX), ($cursor.Y - $global:offY))
    })
    $global:pic.Add_MouseUp({
        if ($_.Button -ne [System.Windows.Forms.MouseButtons]::Left) { return }
        $global:dragging = $false
        $global:pic.Capture = $false
        & $global:SavePetPos
    })
    $global:form.Add_KeyDown({
        if ($_.KeyCode -eq [System.Windows.Forms.Keys]::Escape) { $global:form.Close() }
    })

    $global:frameTimer = New-Object System.Windows.Forms.Timer
    $global:frameTimer.Interval = 90
    $global:frameTimer.Add_Tick({
        $global:frameIndex = $global:frameIndex + 1
        if ($global:frameIndex -ge $global:frames.Count) {
            $global:frameTimer.Stop()
            $global:playing = $false
            $global:frameIndex = 0
            $global:pic.Image = $global:frames[0]
            return
        }
        $global:pic.Image = $global:frames[$global:frameIndex]
    })

    $global:startAction = {
        if ($global:playing) { return }
        $global:playing = $true
        $global:frameIndex = 0
        $global:pic.Image = $global:frames[0]
        $global:frameTimer.Start()
    }

    $global:actionTimer = New-Object System.Windows.Forms.Timer
    $global:actionTimer.Interval = 5000
    $global:actionTimer.Add_Tick({ & $global:startAction })

    $global:form.Add_Shown({
        $global:notify.BalloonTipTitle = $global:petName
        $global:notify.BalloonTipText = $global:tipText
        $global:notify.ShowBalloonTip(4000)
        & $global:startAction
        $global:actionTimer.Start()
    })

    $global:form.Add_FormClosed({
        try { $global:actionTimer.Stop() } catch {}
        try { $global:frameTimer.Stop() } catch {}
        & $global:SavePetPos
        try { $global:notify.Visible = $false } catch {}
        try { $global:notify.Dispose() } catch {}
        try { $global:actionTimer.Dispose() } catch {}
        try { $global:frameTimer.Dispose() } catch {}
        foreach ($frame in $global:frames) { $frame.Dispose() }
        if ($global:mutexOwned) {
            try { $global:mutex.ReleaseMutex() } catch {}
        }
        try { $global:mutex.Dispose() } catch {}
    })

    [System.Windows.Forms.Application]::Run($global:form)
} catch {
    if ($global:mutexOwned) {
        try { $global:mutex.ReleaseMutex() } catch {}
    }
    try { if ($global:mutex) { $global:mutex.Dispose() } } catch {}
    try {
        Add-Type -AssemblyName System.Windows.Forms
        [System.Windows.Forms.MessageBox]::Show($_.Exception.ToString(), 'Desktop Pet')
    } catch {
        Write-Error $_
    }
    exit 1
}
