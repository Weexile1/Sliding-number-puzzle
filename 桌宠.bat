@echo off
setlocal EnableExtensions
REM Tabby desktop pet. Left-drag to move. The cat acts every 5 seconds.
REM Right-click the cat or its tray icon to exit. Esc closes it too.
if /I "%~1"=="RUN" goto run
set "PETBAT=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand UwB0AGEAcgB0AC0AUAByAG8AYwBlAHMAcwAgAC0ARgBpAGwAZQBQAGEAdABoACAAJABlAG4AdgA6AEMAbwBtAFMAcABlAGMAIAAtAEEAcgBnAHUAbQBlAG4AdABMAGkAcwB0ACAAKAAnAC8AYwAgACIAJwAgACsAIAAkAGUAbgB2ADoAUABFAFQAQgBBAFQAIAArACAAJwAiACAAUgBVAE4AJwApACAALQBXAGkAbgBkAG8AdwBTAHQAeQBsAGUAIABIAGkAZABkAGUAbgA=
exit /b 0

:run
set "PETBAT=%~f0"
set "PETPS1=%TEMP%\tabby-desktop-pet-%RANDOM%%RANDOM%.ps1"
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 exit /b 1
powershell.exe -NoProfile -STA -WindowStyle Hidden -ExecutionPolicy Bypass -File "%PETPS1%"
set "EC=%ERRORLEVEL%"
del /f /q "%PETPS1%" >nul 2>&1
exit /b %EC%

###PET_PS1###
$ErrorActionPreference = 'Stop'

$csharp = @'
using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.IO;
using System.Runtime.InteropServices;

public static class PetFrames {
    [DllImport("user32.dll")]
    public static extern bool SetProcessDPIAware();

    public static Bitmap Load(byte[] data) {
        using (var ms = new MemoryStream(data))
        using (var src = new Bitmap(ms)) {
            var bmp = new Bitmap(src.Width, src.Height, PixelFormat.Format24bppRgb);
            using (var g = Graphics.FromImage(bmp)) {
                g.DrawImage(src, 0, 0, src.Width, src.Height);
            }
            var rect = new Rectangle(0, 0, bmp.Width, bmp.Height);
            var bits = bmp.LockBits(rect, ImageLockMode.ReadWrite, PixelFormat.Format24bppRgb);
            try {
                int stride = bits.Stride;
                int count = stride * bmp.Height;
                byte[] buf = new byte[count];
                Marshal.Copy(bits.Scan0, buf, 0, count);
                for (int y = 0; y < bmp.Height; y++) {
                    int row = y * stride;
                    for (int x = 0; x < bmp.Width; x++) {
                        int i = row + x * 3;
                        int b = buf[i];
                        int gc = buf[i + 1];
                        int r = buf[i + 2];
                        if (gc < 100 && r > 135 && b > 135 && Math.Abs(r - b) < 85 && (r + b) > gc * 3) {
                            buf[i] = 255;
                            buf[i + 1] = 0;
                            buf[i + 2] = 255;
                        }
                    }
                }
                Marshal.Copy(buf, 0, bits.Scan0, count);
            } finally {
                bmp.UnlockBits(bits);
            }
            return bmp;
        }
    }
}
'@

try {
    Add-Type -TypeDefinition $csharp -ReferencedAssemblies System.Drawing
    [PetFrames]::SetProcessDPIAware() | Out-Null
    Add-Type -AssemblyName System.Windows.Forms
    Add-Type -AssemblyName System.Drawing

    $global:mutex = New-Object System.Threading.Mutex($false, 'Local\TabbyDesktopPet')
    $global:mutexOwned = $false
    try {
        $global:mutexOwned = $global:mutex.WaitOne(0)
    } catch [System.Threading.AbandonedMutexException] {
        $global:mutexOwned = $true
    }
    if (-not $global:mutexOwned) {
        $global:mutex.Dispose()
        return
    }

